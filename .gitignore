# --- secrets: never commit ---
.env
.env.local
.env.*.local
*.pem
*.key

# `.vercel/` holds `.env.production.local` — every production secret, in clear.
# It was excluded only by `.git/info/exclude`, which is local to one machine and
# is never committed, so the protection did not travel with the repository: a
# fresh clone that ran `vercel link` had nothing stopping the next `git add -A`.
# Verified never committed (`git log --all -- .vercel` is empty) before adding
# this, so there is no history to purge.
.vercel/

# --- dependencies ---
node_modules/
.pnpm-store/

# --- build output ---
.next/
.next-*/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# --- harvested competitor snapshots (large, regenerable, and not ours to redistribute) ---
# Exclude the CONTENTS, not the directory: git cannot re-include a file inside an
# excluded directory, so `sources/raw/` + `!sources/raw/.gitkeep` silently keeps
# the .gitkeep untracked and the directory vanishes on a fresh clone.
sources/raw/*
!sources/raw/.gitkeep

# --- harvested competitor media: renders, floor plans, photography, PDFs ---
# Third-party copyright. MEDIA-LICENSE.md classifies these internal_only by
# default, and this repository is PUBLIC — committing them would redistribute a
# competitor's marketing assets. Keep originals local; commit only encoded
# derivatives that carry an explicit attributed_display rights decision.
sources/media/*
!sources/media/.gitkeep

# --- generated QA artefacts (repo policy: never keep these) ---
#
# CONVENTIONS forbids generated QA output in the repo, and 39 such files had been
# committed anyway: harness reports, per-run timestamped directories, probe
# transcripts and screenshots. They are regenerable by re-running the harness,
# they carry a timestamp so every run is a new file rather than a diff, and the
# screenshots alone are megabytes.
#
# What is NOT ignored, deliberately: RELEASE-STATUS.md, TRACEABILITY.md and
# QUALITY-REPORT.md live at the repo root. Those are documents that a person
# wrote and a reader is meant to read, not output a script emitted.
quality/results/
quality/layout/
quality/manual/
quality/browser-audit/
quality/e2e/
quality/a11y/
quality/perf/
quality/drift/
quality/browser/
quality/probes/
quality/w3c/
quality/w3g/
quality/*.json
quality/*console.txt
quality/*.txt
quality/**/*.png
test-results/
playwright-report/
qa_output/
*.webm
*.trace.zip

# --- temp ---
.tmp/
.turbo/
*.log

# --- OS / editor ---
Thumbs.db
.DS_Store
.vscode/
.idea/

# --- supabase local ---
supabase/.branches/
supabase/.temp/

# Keep the directory itself, so a fresh clone has somewhere for the harnesses
# to write. Same pattern as sources/media/.gitkeep.
!quality/.gitkeep
quality/manual/.seed-password

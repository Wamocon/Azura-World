# --- secrets: never commit ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- dependencies ---
node_modules/
.pnpm-store/

# --- build output ---
.next/
.next-*/
out/
dist/
build/
*.tsbuildinfo
next-env.d.ts

# --- harvested competitor snapshots (large, regenerable, and not ours to redistribute) ---
# Exclude the CONTENTS, not the directory: git cannot re-include a file inside an
# excluded directory, so `sources/raw/` + `!sources/raw/.gitkeep` silently keeps
# the .gitkeep untracked and the directory vanishes on a fresh clone.
sources/raw/*
!sources/raw/.gitkeep

# --- harvested competitor media: renders, floor plans, photography, PDFs ---
# Third-party copyright. MEDIA-LICENSE.md classifies these internal_only by
# default, and this repository is PUBLIC — committing them would redistribute a
# competitor's marketing assets. Keep originals local; commit only encoded
# derivatives that carry an explicit attributed_display rights decision.
sources/media/*
!sources/media/.gitkeep

# --- generated QA artefacts (repo policy: never keep these) ---
quality/results/
quality/layout/
quality/manual/
quality/browser-audit/
test-results/
playwright-report/
qa_output/
*.webm
*.trace.zip

# --- temp ---
.tmp/
.turbo/
*.log

# --- OS / editor ---
Thumbs.db
.DS_Store
.vscode/
.idea/

# --- supabase local ---
supabase/.branches/
supabase/.temp/

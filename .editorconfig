root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# SQL migrations must be LF — CRLF breaks the Supabase CLI
[*.sql]
indent_size = 2
end_of_line = lf

[*.{py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false   # two trailing spaces are a hard line break

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

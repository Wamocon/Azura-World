{
  "name": "azura-world",
  "private": true,
  "version": "0.1.0",
  "description": "Azura World CATI — evidence-backed property-management ERP for Azura World Residence & Hotel (INTERNAL-107)",
  "scripts": {
    "build": "turbo run build",
    "dataset": "python scripts/build-azura-dataset.py",
    "db:test": "npx supabase test db",
    "dev": "turbo run dev",
    "harvest": "node scripts/harvest-azura.mjs",
    "lint": "turbo run lint",
    "qa:csp": "node scripts/csp-probe.mjs",
    "qa:dashboard": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/dashboard-probe.mts",
    "qa:evidence": "node scripts/verify-evidence.mjs",
    "qa:layout": "node scripts/layout-audit.mjs",
    "qa:perf": "node scripts/perf.mjs",
    "quality:gate": "node scripts/quality-gate.mjs",
    "setup:supabase": "node scripts/setup-supabase.mjs",
    "smoke:contracts": "node --experimental-strip-types scripts/smoke-contracts.mts",
    "test": "turbo run test",
    "test:contract": "node scripts/validate-openapi.mjs",
    "typecheck": "turbo run typecheck",
    "verify:supabase": "node scripts/verify-supabase.mjs"
  },
  "devDependencies": {
    "pg": "^8.13.1",
    "turbo": "^2.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": ">=8.5.18"
    }
  },
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=20.0.0"
  }
}

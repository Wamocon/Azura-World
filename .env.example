# Azura World CATI — environment template
#
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# NEVER put a real value in this file.
#
# Variable names mirror the 1Çatı reference project so scripts and conventions
# transfer unchanged. Azura-specific additions are marked [AZURA].

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. BYPASSES ROW LEVEL SECURITY ENTIRELY — full read/write on every
# table regardless of policy. Never expose to the browser, never log it, never
# put it in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, for migrations, pgTAP and psql.
# Dashboard → Project Settings → Database → Connection string → URI
# NEVER port 6543 — the transaction pooler does not support prepared statements
# or advisory locks, and migrations fail on it with confusing errors.
#
# HANDOFF/W0-ENV.md verified and chose the DIRECT host instead of the pooler:
#   postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres
# It is a real Postgres connection (prepared statements, advisory locks,
# LISTEN/NOTIFY), which is what migrations and pgTAP want. Caveat: the direct
# host is IPv6-only. On a machine or CI runner without IPv6, fall back to the
# SESSION pooler on 5432, shown below. lib/env.ts accepts either and rejects 6543.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Project ref alone, for the Supabase CLI (`supabase link --project-ref`)
SUPABASE_PROJECT_REF=your-project-ref

# ─────────────────────────────────────────────────────────────────────────────
# Storage buckets
# ─────────────────────────────────────────────────────────────────────────────
DOCUMENT_STORAGE_MODE=supabase
SUPABASE_DOCUMENT_BUCKET=azura-documents
SUPABASE_EVIDENCE_BUCKET=azura-evidence          # [AZURA] raw source snapshots

# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets — generate independent high-entropy values.
# Do NOT reuse or derive any of these from the service-role key.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ─────────────────────────────────────────────────────────────────────────────
CALENDAR_FEED_TOKEN_SECRET=replace-with-48-random-bytes
PUBLIC_REPORT_SECURITY_SECRET=replace-with-48-random-bytes
REGISTRATION_IDENTITY_PEPPER=replace-with-48-random-bytes
REGISTRATION_RECEIPT_PEPPER=replace-with-48-random-bytes
EVIDENCE_SNAPSHOT_HMAC_SECRET=replace-with-48-random-bytes   # [AZURA] snapshot integrity

# ─────────────────────────────────────────────────────────────────────────────
# AI gateway — OpenAI-compatible, provider-agnostic
# ─────────────────────────────────────────────────────────────────────────────
AI_API_URL=https://your-ai-host.example.com/api
AI_API_KEY=your-ai-api-key
AI_CHAT_COMPLETIONS_PATH=/chat/completions
AI_MODEL_FAST=sokrates-fast
AI_MODEL_REASONING=qwen3.6-35b
AI_MODEL_GERMAN_COPY=gemma4-31b
AI_MODEL_PRO=sokrates-pro

# ─────────────────────────────────────────────────────────────────────────────
# [AZURA] Harvest — competitor source collection
# ─────────────────────────────────────────────────────────────────────────────
HARVEST_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36
HARVEST_MIN_DELAY_MS=2000            # politeness floor, per host
HARVEST_MAX_CONCURRENCY=3            # across hosts; always 1 per host
HARVEST_ALLOW_INVALID_TLS=false      # azuraworldhotel.com has a bad chain — opt in explicitly

# ─────────────────────────────────────────────────────────────────────────────
# Currency display. Rates are for DISPLAY ONLY and must be shown with this date.
# The pipeline never converts; see CONVENTIONS.md §5.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_EUR_TRY_RATE=0
NEXT_PUBLIC_EUR_USD_RATE=0
NEXT_PUBLIC_FX_RATE_DATE=

# ─────────────────────────────────────────────────────────────────────────────
# Controlled demo access profiles — QA ONLY.
# All three must be true to enable. A production deployment never permits
# no-password role switching regardless of these flags (enforced in W1-B).
# ─────────────────────────────────────────────────────────────────────────────
ENABLE_ACCESS_PROFILES=false
AZURA_ALLOW_REMOTE_ACCESS_PROFILES=false
AZURA_DEMO_DATA_ISOLATED=false

# ─────────────────────────────────────────────────────────────────────────────
# Jira — INTERNAL-107. Only needed for ticket sync; never run without --dry-run
# unless explicitly approved.
# ─────────────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://wamocon.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=INTERNAL

# ─────────────────────────────────────────────────────────────────────────────
# Local tooling
# ─────────────────────────────────────────────────────────────────────────────
PLAYWRIGHT_BROWSERS_PATH=.tmp/pw
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3200

# Keys the opaque record identifiers that appear in URLs (apps/web/lib/public-id.ts).
# Without it the app refuses to build a link rather than falling back to raw
# database ids. Rotating it invalidates every existing link — which is how you
# revoke an address that leaked.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
PUBLIC_ID_SECRET=
